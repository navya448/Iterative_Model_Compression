{
    "model": "ResNet-18",
    "dataset": "CIFAR-10",
    "device": "cuda",
    "dense_checkpoint": "checkpoints/epoch_200.pth",
    "pruning_method": "Global Iterative Magnitude Pruning",
    "target_sparsities": [
        0.2,
        0.4,
        0.6,
        0.8,
        0.9
